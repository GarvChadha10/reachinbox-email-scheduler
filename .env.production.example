# Copy to .env.production on the server and fill in. Never commit .env.production.
# Note: Docker env files don't support comments after a value; keep comments on their own lines.

# Public hostname Caddy serves (and gets an HTTPS certificate for), e.g. 140-238-1-2.sslip.io
SITE_ADDRESS=
# All three are https://<SITE_ADDRESS> (the last one plus /api/auth/google/callback)
FRONTEND_URL=
PUBLIC_BACKEND_URL=
GOOGLE_REDIRECT_URI=

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Queue dashboard login; password: openssl rand -hex 12
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=

WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
SENDING_LEASE_MS=300000
MAX_RECIPIENTS_PER_CAMPAIGN=10000
SENDER_COUNT=3
SENDER_DOMAIN=scheduler.local
