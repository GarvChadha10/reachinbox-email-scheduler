{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=../.env src/api/server.ts",
    "dev:worker": "tsx --env-file-if-exists=../.env src/worker/worker.ts",
    "start:api": "tsx --env-file-if-exists=../.env src/api/server.ts",
    "start:worker": "tsx --env-file-if-exists=../.env src/worker/worker.ts",
    "db:migrate": "dotenv -e ../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../.env -- prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=../.env scripts/seed.ts",
    "es:reindex": "tsx --env-file-if-exists=../.env scripts/es-reindex.ts",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev:session": "tsx --env-file-if-exists=../.env scripts/dev-session.ts",
    "e2e:restart": "tsx --env-file-if-exists=../.env scripts/e2e-restart.ts",
    "e2e:redis": "tsx --env-file-if-exists=../.env scripts/e2e-redis.ts",
    "e2e:two-workers": "tsx --env-file-if-exists=../.env scripts/e2e-two-workers.ts",
    "load-test": "tsx --env-file-if-exists=../.env scripts/load-test.ts",
    "slack:demo": "tsx --env-file-if-exists=../.env scripts/slack-demo.ts",
    "ethereal": "tsx --env-file-if-exists=../.env scripts/ethereal-senders.ts"
  },
  "dependencies": {
    "@bull-board/api": "6.21.3",
    "@bull-board/express": "6.21.3",
    "@elastic/elasticsearch": "8.19.2",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.1.0",
    "express-rate-limit": "8.7.3",
    "google-auth-library": "9.15.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "7.0.13",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.18.0",
    "@types/nodemailer": "7.0.4",
    "@types/supertest": "6.0.3",
    "dotenv-cli": "8.0.0",
    "eslint": "9.39.1",
    "pino-pretty": "13.1.2",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  }
}
