generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  googleSub String   @unique @map("google_sub")
  email     String   @unique
  name      String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  campaigns       Campaign[]
  emails          Email[]
  slackConnection SlackConnection?
  notifications   NotificationLog[]

  @@map("users")
}

model Sender {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String   @map("display_name")
  smtpHost    String   @map("smtp_host")
  smtpPort    Int      @map("smtp_port")
  smtpUser    String   @map("smtp_user")
  smtpPass    String   @map("smtp_pass")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  emails        Email[]
  notifications NotificationLog[]

  @@map("senders")
}

model Campaign {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key")
  subject        String
  body           String
  startAt        DateTime @map("start_at") @db.Timestamptz(3)
  delayMs        Int      @map("delay_ms")
  hourlyLimit    Int      @map("hourly_limit")
  totalCount     Int      @map("total_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@unique([userId, idempotencyKey])
  @@map("campaigns")
}

model Email {
  id               String    @id @default(uuid()) @db.Uuid
  seq              BigInt    @default(autoincrement())
  campaignId       String    @map("campaign_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  senderId         String    @map("sender_id") @db.Uuid
  recipientEmail   String    @map("recipient_email")
  status           String    @default("scheduled")
  scheduledAt      DateTime  @map("scheduled_at") @db.Timestamptz(3)
  plannedIndex     Int       @map("planned_index")
  queued           Boolean   @default(false)
  attemptCount     Int       @default(0) @map("attempt_count")
  deferredCount    Int       @default(0) @map("deferred_count")
  sendingStartedAt DateTime? @map("sending_started_at") @db.Timestamptz(3)
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(3)
  failureReason    String?   @map("failure_reason")
  lastError        String?   @map("last_error")
  smtpMessageId    String?   @map("smtp_message_id")
  smtpResponse     String?   @map("smtp_response")
  previewUrl       String?   @map("preview_url")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id])

  @@unique([campaignId, recipientEmail])
  @@index([userId, status, scheduledAt])
  @@index([userId, status, processedAt(sort: Desc)])
  @@map("emails")
}

model SlackConnection {
  userId        String   @id @map("user_id") @db.Uuid
  webhookUrlEnc String   @map("webhook_url_enc")
  teamName      String?  @map("team_name")
  channelName   String?  @map("channel_name")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("slack_connections")
}

model NotificationLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  senderId    String   @map("sender_id") @db.Uuid
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  kind        String
  status      String
  response    String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender @relation(fields: [senderId], references: [id])

  @@unique([userId, senderId, windowStart, kind])
  @@map("notification_log")
}
