# ---------- Runtime ----------
NODE_ENV=development
PORT=4000
# Where the React app runs (Vite dev server). Used for CORS and post-login redirects.
FRONTEND_URL=http://localhost:5173
# Public HTTPS URL that tunnels to this backend (PORT). Needed ONLY for Slack OAuth, because
# Slack requires https redirect URLs. Example: `cloudflared tunnel --url http://localhost:4000`
# or `ngrok http 4000`, then paste the https URL here (no trailing slash).
PUBLIC_BACKEND_URL=

# ---------- Infra (docker compose up -d) ----------
# Host ports 55432/56379 are used to avoid clashing with other local Postgres/Redis instances.
DATABASE_URL=postgresql://scheduler:scheduler@localhost:55432/scheduler?schema=public
REDIS_URL=redis://localhost:56379
ELASTICSEARCH_URL=http://localhost:9200

# ---------- Secrets you generate locally ----------
# Any long random string:  openssl rand -hex 32
JWT_SECRET=
# 32 bytes as 64 hex chars (AES-256-GCM key for Slack webhook URLs):  openssl rand -hex 32
ENCRYPTION_KEY=

# ---------- Google OAuth ----------
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web application).
# Authorized redirect URI must be exactly GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ---------- Slack OAuth ----------
# https://api.slack.com/apps -> Create New App -> Basic Information -> App Credentials.
# OAuth & Permissions: add Redirect URL ${PUBLIC_BACKEND_URL}/api/slack/callback
# and bot scope `incoming-webhook`.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ---------- Bull Board (/admin/queues): open to signed-in users; optional Basic auth for scripts ----------
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=

# ---------- Scheduler tuning ----------
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
SENDING_LEASE_MS=300000
MAX_RECIPIENTS_PER_CAMPAIGN=10000
# Number of Ethereal sender accounts to keep in the pool (created via nodemailer.createTestAccount()).
SENDER_COUNT=3
# Domain used in deterministic Message-ID headers: <email-{id}@SENDER_DOMAIN>
SENDER_DOMAIN=scheduler.local
